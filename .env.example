# Semua opsional. Tanpa key, sistem tetap jalan dengan batas gratis.
PORT=3000
# CoinGecko Demo key (gratis, daftar di coingecko.com/en/developers/dashboard) -> kuota lebih stabil
COINGECKO_DEMO_KEY=
# Telegram: buat bot via @BotFather, ambil chat id. Tanpa ini alert hanya tampil di dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Wajib diisi agar POST /api/refresh aktif (kirim header x-admin-token)
ADMIN_TOKEN=
# Jumlah reverse proxy tepercaya di depan aplikasi; default 0 (abaikan X-Forwarded-For).
# Isi hanya jika proxy menghapus header masuk dan menambahkan X-Forwarded-For sendiri.
TRUSTED_PROXY_HOPS=0
# Screener
MIN_MCAP=1000000
MAX_MCAP=100000000
MIN_VOLUME=50000
MAX_PAGES=4
# Alert
PRICE_ALERT_PCT=15
VOLUME_SPIKE_X=3
MIN_VOLUME_DELTA_USD=5000
UNLOCK_DAYS=7
ALERT_COOLDOWN_H=6
# Refresh (menit)
REFRESH_MIN=10
# Kategori DeFiLlama (cocok persis, pisahkan koma)
LLAMA_CATEGORIES=AI,DePIN,Compute
# Feed RSS (pisahkan koma). Belum diuji dari lingkungan pengembangan (tanpa internet).
NEWS_FEEDS=https://techcrunch.com/category/artificial-intelligence/feed/,https://cointelegraph.com/rss
# Token unlock: salah satu. File manual data/unlocks.json ATAU URL JSON dengan format sama.
UNLOCKS_URL=
# Origin yang boleh memanggil API dari domain lain (kosong = hanya same-origin)
CORS_ORIGIN=
DATA_DIR=./data
# Volume asli 10 menit (candle 5m Binance Spot, endpoint publik). Bursa dapat memblokir wilayah tertentu (HTTP 451/403): cek status 'exchange'.
EXCHANGE_ENABLED=1
EXCHANGE_BASE=https://data-api.binance.vision
EXCH_QUOTE=USDT
MAX_EXCH_TOKENS=120
VOL10_MIN_BUCKETS=12
VOL10_MIN_USD=2000
# Alert ESTIMASI selisih volume 24j (hanya untuk token tanpa data candle asli); 0 = matikan
VOLUME_EST_ALERTS=1

# Exchange Hub — read-only only. Set values in Hostless server environment, never in frontend or Git.
# Use API keys with reading/account permissions only. Disable withdrawals and all trading permissions.
# Secret aliases *_SECRET_KEY and *_SECRET are also accepted by the backend.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE=https://api.binance.com
BINANCE_FUTURES_BASE=https://fapi.binance.com
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_API_BASE=https://api.bybit.com
BYBIT_ACCOUNT_TYPE=UNIFIED

# Protect private Exchange Hub account reads. If unset, ADMIN_TOKEN is used as fallback.
EXCHANGE_ACCESS_TOKEN=

# Extensible AI Workspace providers (OpenAI-compatible only).
# One block per provider; the uppercase ID becomes the participant ID in Command Center.
# Provider keys are secrets: set them only in the server/Hostless environment, never in Git or browser.
# A custom provider is available only when ENABLED=1 and COST_CLASS=free; it is opt-in per meeting.
# Verify the provider's free quota and overage terms before marking COST_CLASS=free.
# AI_WORKSPACE_ALLOW_PAID=0 blocks paid built-ins such as OpenAI under the Rp0 policy.
AI_WORKSPACE_ALLOW_PAID=0
# AI_PROVIDER_DEEPSEEK_ENABLED=1
# AI_PROVIDER_DEEPSEEK_COST_CLASS=free
# AI_PROVIDER_DEEPSEEK_API_KEY=
# AI_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AI_PROVIDER_DEEPSEEK_MODEL=deepseek-chat
# AI_PROVIDER_DEEPSEEK_PROTOCOL=openai-compatible
# AI_PROVIDER_DEEPSEEK_DISPLAY_NAME=DeepSeek
# AI_PROVIDER_DEEPSEEK_ROLE=Independent strategy and engineering reviewer
